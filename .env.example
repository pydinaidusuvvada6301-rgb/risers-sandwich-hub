# ==============================================================
# RISERS Sandwich Hub - Environment Configuration Template
# ==============================================================
# Copy this file to .env for local development:
# cp .env.example .env
#
# IMPORTANT:
# - NEVER put secret service-role keys or ADMIN_ACCESS_CODE in this file.
# - Only variables prefixed with VITE_ are exposed to the browser.
# - Server-side secrets are configured in Supabase Edge Functions dashboard.
# ==============================================================

# Supabase Project URL (From Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key (Safe for browser use with RLS enabled)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key-here

# Stall Information (Optional default overrides)
VITE_BUSINESS_NAME=RISERS Sandwich Hub
VITE_BUSINESS_TAGLINE=Rise Together, Serve Better!
VITE_DEFAULT_UPI_ID=risers@upi
