{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/menu", "destination": "/menu.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/track-order", "destination": "/track-order.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/feedback", "destination": "/feedback.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/admin/dashboard", "destination": "/admin/dashboard.html" },
    { "source": "/admin/orders", "destination": "/admin/orders.html" },
    { "source": "/admin/kitchen", "destination": "/admin/kitchen.html" },
    { "source": "/admin/payments", "destination": "/admin/payments.html" },
    { "source": "/admin/transactions", "destination": "/admin/transactions.html" },
    { "source": "/admin/products", "destination": "/admin/products.html" },
    { "source": "/admin/inventory", "destination": "/admin/inventory.html" },
    { "source": "/admin/expenses", "destination": "/admin/expenses.html" },
    { "source": "/admin/cash-register", "destination": "/admin/cash-register.html" },
    { "source": "/admin/reports", "destination": "/admin/reports.html" },
    { "source": "/admin/feedback", "destination": "/admin/feedback.html" },
    { "source": "/admin/staff", "destination": "/admin/staff.html" },
    { "source": "/admin/settings", "destination": "/admin/settings.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
